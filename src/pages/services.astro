import { withBase } from "../lib/url";
import { offerCatalogSchema } from "../lib/seo";

// The menu doubles as structured data: every line here becomes a Service the
// salon offers, so a search for "nanoplastia Chalakudy" can resolve to this
// business rather than to a definition of the treatment.
const serviceSchema = [offerCatalogSchema(Astro.site, menu)];
---
<Layout
  title="Salon Services & Full Menu in Chalakudy | D Cube"
  description="The full menu at D Cube Family Salon, Chalakudy: haircuts, hair colour and balayage, keratin and nanoplastia, hydra facials, bridal and HD makeup, waxing, threading, manicure and pedicure."
  image="/interiors/treatment-02.jpg"
  imageAlt="The treatment room at D Cube Family Salon, Chalakudy"
  breadcrumb={[
    { name: "Home", path: "/" },
    { name: "Services", path: "/services/" },
  ]}
  schema={serviceSchema}
>
  <Banner
    eyebrow="The menu"
    title="Every service we offer."
description="Listed in full, room by room. Rates depend on length, density and the products you choose — we confirm the price with you before we start."
    next="clay"
  />

  <Marquee />

  <section class="section section-cream">
    <div class="container">
      <div class="menu-layout">
        <nav class="menu-rail" aria-label="Service categories">
          {menu.map(m => <a href={`#${m.id}`}>{m.title}</a>)}
        </nav>

        <div>
          {menu.map((m, i) => (
            <section class="menu-block reveal" id={m.id}>
              <h3>
                <span class="idx">{String(i + 1).padStart(2, "0")}</span>
                {m.title}
              </h3>
              <span class="eyebrow" style="margin-bottom:14px;">{m.room}</span>
              <ul class="menu-cols">
                {m.items.map(it => (
                  <li><span class="name">{it}</span></li>
                ))}
              </ul>
            </section>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="section section-sand">
    <div class="container">
      <div class="split">
        <figure class="arch reveal">
          <img src={withBase("/interiors/treatment-02.jpg")} alt="The treatment room with halo-lit arched mirrors" loading="lazy" width="1536" height="1024" />
          <figcaption class="caption">Treatment Room</figcaption>
        </figure>
        <div class="reveal d1">
          <span class="eyebrow">Not sure what to book?</span>
          <h2>Tell us the occasion. We'll build the package.</h2>
          <p class="lead">A wedding morning, a first haircut, a monthly reset — send us the date and what it's for, and we'll come back with the services, the room and the time it takes.</p>
          <div class="hero-actions" style="justify-content:flex-start; margin-top:26px;">
            <a href={withBase("/contact")} class="btn btn-clay">Ask a Stylist</a>
            <a href="tel:+919946007990" class="btn btn-outline">Call the Salon</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="cta plaster">
    <div class="container reveal">
      <h2>Hold your slot.</h2>
      <p>Weekends and wedding season fill first. A booking takes a minute.</p>
      <div class="cta-actions">
        <a href={withBase("/contact")} class="btn btn-cream">Book a Chair</a>
      </div>
    </div>
  </section>
</Layout>
