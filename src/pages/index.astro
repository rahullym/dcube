---
import Layout from "../layouts/Layout.astro";
import Marquee from "../components/Marquee.astro";
import Niche from "../components/Niche.astro";
import ZoneRail from "../components/ZoneRail.astro";
import { getPlaceReviews } from "../lib/reviews";
import { lookbook, serviceMedia } from "../lib/work";
import { withBase } from "../lib/url";

const place = await getPlaceReviews();
const quotes = place.reviews.slice(0, 3);

const shades = [
  { hex: "#1C1512", name: "Natural Black" },
  { hex: "#3B2318", name: "Espresso" },
  { hex: "#5C3320", name: "Chestnut" },
  { hex: "#7E4229", name: "Terracotta" },
  { hex: "#9A5133", name: "Copper" },
  { hex: "#B5713F", name: "Caramel" },
  { hex: "#C99356", name: "Honey" },
  { hex: "#DDB97E", name: "Champagne" },
  { hex: "#8B7355", name: "Ash Mocha" },
  { hex: "#6E4B6B", name: "Plum" },
  { hex: "#7A2E38", name: "Merlot" },
  { hex: "#B8B0A6", name: "Silver" },
];
---
<Layout>
  <!-- ============ HERO ============ -->
  <section class="hero plaster">
    <div class="hero-inner container">
      <div class="hero-copy">
        <span class="eyebrow">Chalakudy · Unisex Family Salon</span>
        <h1>Brides, grooms and everyone <em>getting ready</em>.</h1>
        <p class="lead">Bridal makeup, hair, skin, nails and grooming — for the whole family, by a team that has done this a few hundred times.</p>
        <div class="hero-actions">
          <a href={withBase("/contact")} class="btn btn-cream">Book a Chair</a>
          <a href={withBase("/services")} class="btn btn-outline-cream">See Services</a>
        </div>
        <ul class="hero-facts">
          <li>Open Mon – Sat · 10am – 8pm</li>
          <li>Bridal suite &amp; wardrobe</li>
          <li>Walk-ins welcome</li>
        </ul>
      </div>

      <div class="hero-art">
        <figure class="hero-frame hero-frame-main">
          <img src={withBase("/work/bridal-kanjeevaram.jpg")} alt="A D Cube bride in a cream and violet Kanjeevaram saree with gold temple jewellery" width="1080" height="1350" fetchpriority="high" />
        </figure>
        <figure class="hero-frame hero-frame-inset">
          <img src={withBase("/work/groom-beard.jpg")} alt="A groom with a shaped beard and styled hair, finished at D Cube" width="1080" height="1261" />
        </figure>
        {place.rating != null && place.totalRatings != null && (
          <div class="hero-badge">
            <span class="stars" aria-hidden="true">★★★★★</span>
            <strong>{place.rating.toFixed(1)}</strong>
            <span>{place.totalRatings}+ Google reviews</span>
          </div>
        )}
      </div>
    </div>
  </section>

  <Marquee />

  <!-- ============ THE WORK — leads the page ============ -->
  <section class="section section-cream">
    <div class="container">
      <div class="section-head centered reveal">
        <span class="eyebrow centered">Our work</span>
        <h2>Looks that left our chairs.</h2>
        <p>Wedding mornings, receptions, first haircuts and everything between — all of it done here.</p>
      </div>
      <div class="lookbook reveal">
        {lookbook.slice(0, 6).map(l => (
          <figure class="look">
            <img src={withBase(l.src)} alt={l.alt} loading="lazy" width="1080" height="1350" />
            <figcaption>{l.label}</figcaption>
          </figure>
        ))}
      </div>
      <div class="center mt-lg">
        <a href={withBase("/gallery")} class="btn btn-outline">See More of Our Work</a>
      </div>
    </div>
  </section>

  <!-- ============ SERVICES ============ -->
  <section class="section section-sand">
    <div class="container">
      <div class="section-head centered reveal">
        <span class="eyebrow centered">What we do</span>
        <h2>Everything the family needs, under one roof.</h2>
        <p>Women, men and kids — bridal through to a fortnightly trim, with the full menu published.</p>
      </div>
      <div class="niche-grid" data-stagger>
        <Niche icon="✦" title="Bridal & Occasion" description="HD and airbrush bridal makeup, pre-bridal courses, draping, and a wardrobe of gowns and lehengas next door." media={serviceMedia.bridal} />
        <Niche icon="✂" title="Hair Studio" description="Cuts, global colour, balayage, keratin and smoothing — for women, men and kids." filled={true} delay="d1" media={serviceMedia.hair} />
        <Niche icon="✧" title="Makeup" description="Party, engagement and event makeup, plus one-to-one lessons and a lit photo corner." delay="d2" media={serviceMedia.makeup} />
        <Niche icon="◈" title="Groom & Men's" description="Cuts, beard shaping, groom makeup and grooming packages for the wedding party." delay="d1" media={serviceMedia.groom} />
        <Niche icon="❋" title="Skin & Facials" description="Clean-ups, brightening and anti-ageing facials, peels and threading in dedicated rooms." delay="d2" media={serviceMedia.skin} />
        <Niche icon="◇" title="Nails" description="Manicures, spa pedicures, gel extensions and nail art at the bar beside the studio." delay="d3" media={serviceMedia.nails} />
      </div>
      <div class="center mt-lg">
        <a href={withBase("/services")} class="btn btn-clay">See the Full Menu</a>
      </div>
    </div>
  </section>

  <!-- ============ BRIDAL ============ -->
  <section class="section section-cream">
    <div class="container">
      <div class="split">
        <figure class="arch reveal">
          <img src={withBase("/work/bridal-navy.jpg")} alt="A D Cube bride in navy and gold with a gold choker and mehendi" loading="lazy" width="1080" height="1440" />
          <figcaption class="caption">Bridal</figcaption>
        </figure>
        <div class="reveal d1">
          <span class="eyebrow">For the big morning</span>
          <h2>Get ready and get dressed in the same building.</h2>
          <p class="lead">Trial your makeup, book a private suite for the morning itself, and pick the outfit from our bridal wardrobe — without driving anywhere in between.</p>
          <p>Wedding-season Saturdays book out weeks ahead. A trial is the fastest way to hold your date.</p>
          <div class="hero-actions" style="justify-content:flex-start; margin-top:26px;">
            <a href={withBase("/contact")} class="btn btn-clay">Book a Bridal Trial</a>
            <a href={withBase("/gallery")} class="btn btn-outline">See Bridal Work</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ COLOUR ============ -->
  <section class="section section-clay plaster">
    <div class="container">
      <div class="split reverse">
        <figure class="arch reveal">
          <img src={withBase("/work/party-curls.jpg")} alt="Soft curls and party makeup finished at the salon" loading="lazy" width="1080" height="1343" />
          <figcaption class="caption">Colour & Styling</figcaption>
        </figure>
        <div class="reveal d1">
          <span class="eyebrow">Choose your shade</span>
          <h2>A colour wall, not a colour book.</h2>
          <p class="lead">We keep every shade we stock on the wall above the basins, so you pick against your own skin in real light — not off a laminated card under a fluorescent tube.</p>
          <div class="shade-strip">
            {shades.map(s => (
              <span class="swatch" style={`background:${s.hex}`} data-name={s.name} title={s.name}></span>
            ))}
          </div>
          <a href={withBase("/services")} class="btn btn-outline-cream mt-lg">Colour & Highlight Services</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ THE ROOMS — supporting, not leading ============ -->
  <section class="section section-sand">
    <div class="container">
      <ZoneRail />
    </div>
  </section>

  <!-- ============ REVIEWS ============ -->
  {quotes.length > 0 && (
  <section class="section section-cream">
    <div class="container">
      <div class="section-head centered reveal">
        <span class="eyebrow centered">
          {place.rating != null && place.totalRatings != null
            ? `${place.rating.toFixed(1)} ★ · ${place.totalRatings}+ Google reviews`
            : "In our guests' words"}
        </span>
        <h2>What Chalakudy says.</h2>
      </div>
      <div class="quote-grid" data-stagger>
        {quotes.map((r, i) => (
          <figure class={`quote reveal ${i === 1 ? "d1" : i === 2 ? "d2" : ""}`}>
            <div class="mark" aria-hidden="true">“</div>
            <div class="rate" aria-label={`${r.rating} out of 5`}>{"★".repeat(Math.round(r.rating))}</div>
            <blockquote>{r.text}</blockquote>
            <figcaption class="who">{r.author}{r.relativeTime ? ` · ${r.relativeTime}` : ""}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>
  )}

  <!-- ============ CTA ============ -->
  <section class="cta plaster">
    <div class="container reveal">
      <span class="eyebrow centered">Open Mon – Sat, 10am – 8pm</span>
      <h2>Book your chair.</h2>
      <p>Walk-ins are welcome. Bookings get the stylist, the hour and the room you wanted.</p>
      <div class="cta-actions">
        <a href={withBase("/contact")} class="btn btn-cream">Book a Chair</a>
        <a href="tel:+919946007990" class="btn btn-outline-cream">+91 99460 07990</a>
      </div>
    </div>
  </section>
</Layout>
