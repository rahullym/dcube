---
import Layout from "../layouts/Layout.astro";
import Banner from "../components/Banner.astro";
import { zones, shots } from "../lib/zones";

const zoneName = Object.fromEntries(zones.map(z => [z.slug, z.name]));
import { withBase } from "../lib/url";
---
<Layout
  title="The Space — D Cube Family Salon"
  description="Walk the D Cube floor: reception and lobby, hair studio, wash lounge, hair spa, treatment room, VIP suites, facial rooms, makeup studio, nail bar and the bridal wardrobe."
>
  <Banner
    eyebrow="Interior views"
    title="The space, room by room."
    description="Terracotta plaster, lime-washed arches and backlit mirrors, drawn for us by Ar. Sneha Raju. Tap any view to enlarge."
    next="sand"
  />

  <section class="section section-sand">
    <div class="container-wide">
      <div class="filter-bar reveal" role="group" aria-label="Filter by room">
        <button class="chip active" data-filter="all">All Rooms</button>
        {zones.map(z => <button class="chip" data-filter={z.slug}>{z.name}</button>)}
      </div>

      <div class="masonry" id="masonry" data-stagger>
        {shots.map(s => (
          <figure class="shot" data-zone={s.zone} tabindex="0" role="button" aria-label={`Enlarge: ${s.alt}`}>
            <img src={withBase(s.src)} alt={s.alt} loading="lazy" width="1536" height="1024" />
            <figcaption>{zoneName[s.zone]}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-cream">
    <div class="container">
      <div class="section-head centered reveal">
        <span class="eyebrow centered">The floor plan</span>
        <h2>What happens where.</h2>
      </div>
      <div class="niche-grid" data-stagger>
        {zones.map((z, i) => (
          <article class={`niche reveal ${i % 3 === 1 ? "d1" : i % 3 === 2 ? "d2" : ""}${i % 4 === 1 ? " filled" : ""}`}>
            <div class="ico" aria-hidden="true">{String(i + 1).padStart(2, "0")}</div>
            <h3>{z.name}</h3>
            <p>{z.blurb}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="cta plaster">
    <div class="container reveal">
      <h2>Pictures are one thing.</h2>
      <p>The plaster, the light and the quiet are another. Come and stand in it.</p>
      <div class="cta-actions">
        <a href={withBase("/contact")} class="btn btn-cream">Book a Chair</a>
        <a href={withBase("/services")} class="btn btn-outline-cream">See the Menu</a>
      </div>
    </div>
  </section>

  <script>
    const initFilters = () => {
      const chips = document.querySelectorAll<HTMLButtonElement>(".chip");
      const shots = document.querySelectorAll<HTMLElement>(".shot");
      if (!chips.length) return;

      const apply = (filter: string) => {
        shots.forEach(s => s.classList.toggle("hidden", filter !== "all" && s.dataset.zone !== filter));
        chips.forEach(c => c.classList.toggle("active", c.dataset.filter === filter));
      };

      chips.forEach(c => {
        if (c.dataset.bound) return;
        c.dataset.bound = "1";
        c.addEventListener("click", () => {
          const f = c.dataset.filter || "all";
          apply(f);
          history.replaceState(null, "", f === "all" ? location.pathname : `#${f}`);
        });
      });

      // Deep links from the home-page room rail: /gallery#vip
      const hash = location.hash.slice(1);
      if (hash && document.querySelector(`.chip[data-filter="${hash}"]`)) apply(hash);
    };
    initFilters();
    document.addEventListener("astro:page-load", initFilters);
  </script>
</Layout>
