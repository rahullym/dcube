---
import Layout from "../layouts/Layout.astro";
import Banner from "../components/Banner.astro";
import Social from "../components/Social.astro";
import { withBase } from "../lib/url";
import { business, canadaStudio } from "../lib/business";
import { faqSchema } from "../lib/seo";

// Questions people actually type before booking, answered in full sentences
// that stand on their own. Written this way on purpose: an answer that needs
// no surrounding context is the kind a search result or an AI assistant can
// lift verbatim, and each one names the town so it matches a local search.
//
// Every question below is also rendered on the page. Marking up an answer the
// reader cannot see is against Google's guidelines, not a shortcut.
const faqs = [
  {
    q: "Where is D Cube Family Salon in Chalakudy?",
    a: `D Cube Family Salon is at ${business.address.streetAddress}, ${business.address.addressLocality}, ${business.address.addressRegion} ${business.address.postalCode} — on the Chalakudy–Athirappilly road, a few minutes from Chalakudy town. Parking is available outside.`,
  },
  {
    q: "What are the salon's opening hours?",
    a: "The salon is open Monday to Saturday from 10am to 8pm, and on Sunday from 11am to 6pm. Walk-ins are welcome during these hours, though weekends and wedding season fill first.",
  },
  {
    q: "Is D Cube a unisex salon?",
    a: "Yes. D Cube is a unisex family salon — women, men and children are all served, in ten separate rooms so that a bridal morning, a first haircut and a quiet facial never share the same space.",
  },
  {
    q: "Do I need to book a bridal makeup trial in advance?",
    a: "Yes, we strongly recommend it. Wedding-season Saturdays in Chalakudy book out weeks ahead, and a trial is the fastest way to hold your date. Call or WhatsApp " + business.telephone + " to arrange one.",
  },
  {
    q: "Which areas does the salon serve?",
    a: `Guests travel to D Cube from ${business.areaServed.slice(0, -1).join(", ")} and across the wider Thrissur district.`,
  },
  {
    q: "Do you take walk-ins, or is booking required?",
    a: "Walk-ins are welcome. Booking is not required, but a booking guarantees the stylist, the hour and the room you wanted — which matters most at weekends and through wedding season.",
  },
];

const contactSchema = [faqSchema(faqs)];
---
<Layout
  title="Visit & Book | D Cube Salon, Chalakudy — Hours & Map"
  description="D Cube Family Salon, Athirappilly Road, opposite FAS Auditorium, Chalakudy 680307. Open Mon–Sat 10am–8pm, Sunday 11am–6pm. Call or WhatsApp +91 99460 07990 to book."
  image="/interiors/reception-03.jpg"
  imageAlt="The view through the lobby arches into the D Cube salon floor"
  breadcrumb={[
    { name: "Home", path: "/" },
    { name: "Visit & Book", path: "/contact/" },
  ]}
  schema={contactSchema}
>
  <Banner
    eyebrow="Visit us"
    title="Book your chair."
    description="Tell us what it's for and when. We'll confirm the room, the stylist and the hour — usually within a few hours."
  />

  <section class="section section-cream">
    <div class="container">
      <div class="split split-form">
        <div class="form-card reveal">
          <h2 style="font-size:clamp(1.5rem,2.6vw,2rem);">Request a booking</h2>
          <p>Walk-ins are welcome, but weekends and wedding season fill first.</p>

          <form id="booking-form" class="form" novalidate>
            <div class="form-row">
              <div>
                <label for="name">Full Name</label>
                <input id="name" name="name" type="text" autocomplete="name" required />
              </div>
              <div>
                <label for="phone">Phone</label>
                <input id="phone" name="phone" type="tel" autocomplete="tel" required />
              </div>
            </div>
            <div>
              <label for="email">Email</label>
              <input id="email" name="email" type="email" autocomplete="email" required />
            </div>
            <div class="form-row">
              <div>
                <label for="service">Service</label>
                <select id="service" name="service" required>
                  <option value="">Select a service</option>
                  <option>Bridal Makeup / Trial</option>
                  <option>Pre-Bridal Package</option>
                  <option>Hair Cut &amp; Style</option>
                  <option>Hair Colour / Highlights</option>
                  <option>Keratin / Smoothing</option>
                  <option>Hair Spa / Treatment</option>
                  <option>Facial / Skin Treatment</option>
                  <option>Makeup / Lesson</option>
                  <option>Manicure / Pedicure / Nails</option>
                  <option>Men's Grooming</option>
                  <option>Kids Cut</option>
                  <option>Other / Consultation</option>
                </select>
              </div>
              <div>
                <label for="date">Preferred Date</label>
                <input id="date" name="date" type="date" required />
              </div>
            </div>
            <div>
              <label for="notes">Anything we should know</label>
              <textarea id="notes" name="notes" placeholder="The occasion, your hair length, who else is coming with you."></textarea>
            </div>
            <button type="submit" class="btn btn-clay" style="justify-self:start;">Request Booking</button>
            <div class="form-msg" role="status" aria-live="polite"></div>
          </form>
        </div>

        <div class="stack-gap reveal d1">
          <div class="info-card">
            <h3>Chalakudy Salon</h3>
            {/* The street address is written out, not just linked to a map pin.
                A crawler cannot read what is behind a Maps link, and the
                address is the single strongest local-search signal a page has. */}
            <div class="info-row">
              <div class="ico" aria-hidden="true">◎</div>
              <div>
                <strong>Address</strong>
                <address style="font-style:normal;">
                  {business.address.streetAddress}<br />
                  {business.address.addressLocality}, {business.address.addressRegion} {business.address.postalCode}<br />
                  India
                </address>
                <a href={business.mapUrl} target="_blank" rel="noopener" style="display:inline-block; margin-top:8px;">Open in Google Maps</a>
              </div>
            </div>
            <div class="info-row">
              <div class="ico" aria-hidden="true">☎︎</div>
              <div><strong>Phone</strong><a href={`tel:${business.telephoneE164}`}>{business.telephone}</a></div>
            </div>
            <div class="info-row">
              <div class="ico" aria-hidden="true">✉︎</div>
              <div><strong>Email</strong><a href={`mailto:${business.email}`}>{business.email}</a></div>
            </div>
            <div class="info-row">
              <div class="ico" aria-hidden="true">◷</div>
              <div><strong>Open</strong>Mon – Sat · 10am – 8pm<br />Sunday · 11am – 6pm</div>
            </div>
          </div>

          <div class="info-card">
            <h3>Canada Studio</h3>
            <div class="info-row">
              <div class="ico" aria-hidden="true">◎</div>
              <div>
                <strong>Address</strong>
                <address style="font-style:normal;">
                  {canadaStudio.address.streetAddress}<br />
                  {canadaStudio.address.addressLocality}, {canadaStudio.address.addressRegion} {canadaStudio.address.postalCode}<br />
                  Canada
                </address>
              </div>
            </div>
            <div class="info-row">
              <div class="ico" aria-hidden="true">☎︎</div>
              <div><strong>Phone</strong><a href={`tel:${canadaStudio.telephoneE164}`}>{canadaStudio.telephone}</a></div>
            </div>
            <div class="info-row">
              <div class="ico" aria-hidden="true">◷</div>
              <div><strong>Open</strong>{canadaStudio.hoursNote}</div>
            </div>
          </div>

          <div class="info-card">
            <h3>Follow the salon</h3>
            <p style="margin-bottom:0;">New looks, offers and bridal work — posted from the floor as it happens.</p>
            <Social />
          </div>

          <figure class="arch reveal d2" style="margin:0; box-shadow:var(--lift-sm);">
            <img src={withBase("/interiors/reception-03.jpg")} alt="The view through the lobby arches into the salon floor" loading="lazy" width="1536" height="1024" style="aspect-ratio:4/3; object-fit:cover;" />
          </figure>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ FAQ ============ -->
  <section class="section section-sand">
    <div class="container-narrow">
      <div class="section-head centered reveal">
        <span class="eyebrow centered">Before you come</span>
        <h2>Questions we get asked.</h2>
      </div>
      <div class="faq reveal">
        {faqs.map(f => (
          <details class="faq-item">
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="cta plaster">
    <div class="container reveal">
      <h2>Prefer to just call?</h2>
      <p>The desk picks up during opening hours, every day but Monday morning.</p>
      <div class="cta-actions">
        <a href={`tel:${business.telephoneE164}`} class="btn btn-cream">{business.telephone}</a>
        <a href={business.whatsapp} target="_blank" rel="noopener" class="btn btn-outline-cream">WhatsApp Us</a>
      </div>
    </div>
  </section>

  <script>
    const initForm = () => {
      const form = document.querySelector<HTMLFormElement>("#booking-form");
      if (!form || form.dataset.bound) return;
      form.dataset.bound = "1";

      const dateInput = form.querySelector<HTMLInputElement>('input[type="date"]');
      if (dateInput) dateInput.min = new Date().toISOString().split("T")[0];

      form.addEventListener("submit", e => {
        e.preventDefault();
        if (!form.checkValidity()) { form.reportValidity(); return; }
        const msg = form.querySelector<HTMLElement>(".form-msg")!;
        msg.classList.add("success");
        msg.textContent = "Thank you — your request is in. We'll confirm your room and time by phone or email shortly.";
        form.reset();
        msg.scrollIntoView({ behavior: "smooth", block: "center" });
      });
    };
    initForm();
    document.addEventListener("astro:page-load", initForm);
  </script>
</Layout>
