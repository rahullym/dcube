      <div>
        <a href="/" class="brand">D<span style="color:var(--color-accent)">CUBE</span></a>
        <p>Unisex beauty, bridal, and family salon serving clients across India and Canada.</p>
      </div>
      <div>
        <h4>Explore</h4>
        <a href="/services">Services</a>
        <a href="/about">About</a>
        <a href="/gallery">Gallery</a>
        <a href="/contact">Contact</a>
      </div>
      <div>
        <h4>Contact</h4>
        <a href="tel:+919946007990">India · +91 99460 07990</a>
        <a href="tel:+19024127235">Canada · +1 902 412 7235</a>
        <a href="mailto:hello@dcubesalon.com">hello@dcubesalon.com</a>
