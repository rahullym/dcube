      d="M12.04 2.5A9.4 9.4 0 0 0 2.63 11.9c0 1.99.52 3.93 1.52 5.64L2.5 21.5l4.1-1.62a9.36 9.36 0 0 0 4.44 1.13h.01a9.4 9.4 0 0 0 0-18.51Z"
      fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"
