    <path
      d="M9.2 8.1c-.16-.37-.33-.34-.5-.35h-.44c-.15 0-.4.06-.6.28-.21.23-.79.77-.79 1.88s.81 2.18.92 2.33c.12.15 1.6 2.44 3.87 3.42.54.23.96.37 1.29.48.54.17 1.03.15 1.42.09.43-.06 1.34-.55 1.53-1.08.19-.53.19-.98.13-1.08-.05-.1-.2-.15-.43-.27-.23-.11-1.34-.66-1.55-.73-.2-.08-.36-.11-.5.11-.15.23-.58.73-.71.88-.13.15-.26.17-.49.06-.23-.12-.96-.36-1.83-1.13-.68-.6-1.13-1.35-1.27-1.58-.13-.22-.01-.35.1-.46.1-.1.23-.26.35-.39.11-.13.15-.23.23-.38.08-.15.04-.29-.02-.4-.06-.12-.5-1.22-.71-1.68Z"
