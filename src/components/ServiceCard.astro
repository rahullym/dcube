---
interface Props { icon: string; title: string; description: string; price?: string; }
const { icon, title, description, price } = Astro.props;
---
<div class="service-card reveal">
  <div class="icon">{icon}</div>
  <h3>{title}</h3>
  <p>{description}</p>
  {price && <span class="price">{price}</span>}
</div>
